{
  "name": "roku-panel",
  "version": "0.1.0",
  "description": "Roku dev panel — Electron UI for controlling a Roku device.",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "node scripts/init-config.js",
    "start": "electron .",
    "dev": "electronmon .",
    "build:mac": "electron-builder --dir --mac --arm64 -c.extraMetadata.projectRoot=\"$PWD\" && npm run sign:mac",
    "build:win": "electron-builder --dir --win --x64",
    "sign:mac": "codesign --force --deep --sign - --identifier com.rokupanel.app \"dist/mac-arm64/Roku dev panel.app\""
  },
  "electronmon": {
    "patterns": [
      "src/**/*",
      "!**/node_modules/**",
      "!config.json",
      "!screenshots/**"
    ]
  },
  "build": {
    "appId": "com.rokupanel.app",
    "productName": "Roku dev panel",
    "asar": false,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.png"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon-mac.png",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Roku dev panel finds Roku devices on your network and sends them remote-control, deploy and screenshot commands."
      }
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "electronmon": "^2.0.3"
  },
  "author": "4TV"
}
